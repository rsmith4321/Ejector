<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><EnableDefaultCompileItems>false</EnableDefaultCompileItems><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup>
  <ItemGroup><Compile Include="OwnedRecordPublication.cs"/><Compile Include="PublicationGuardTests.cs"/><Reference Include="EasyEject.Runtime"><HintPath>$(EasyEjectFixtureBackend)</HintPath><Private>true</Private></Reference></ItemGroup>
  <Target Name="RequireExplicitBackend" BeforeTargets="ResolveReferences"><Error Condition="'$(EasyEjectFixtureBackend)' == '' Or !Exists('$(EasyEjectFixtureBackend)')" Text="Supply the exact existing F810 backend."/></Target>
</Project>
