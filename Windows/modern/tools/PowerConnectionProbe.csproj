<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PowerConnectionProbe.cs" />
    <Reference Include="EasyEject.Runtime">
      <HintPath>$(EasyEjectFixtureBackend)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireExplicitBackend" BeforeTargets="ResolveReferences">
    <Error Condition="'$(EasyEjectFixtureBackend)' == '' Or !Exists('$(EasyEjectFixtureBackend)')" Text="Supply the exact existing review backend with EasyEjectFixtureBackend." />
  </Target>
</Project>
