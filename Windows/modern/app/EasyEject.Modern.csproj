<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EasyEject.Modern</AssemblyName>
    <AssemblyTitle>Easy Eject for Windows</AssemblyTitle>
    <Product>Easy Eject</Product>
    <Description>Easy Eject for Windows</Description>
    <Version>0.2.0-dev</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0-dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>EasyEject.Modern.Program</StartupObject>
    <ApplicationIcon>..\..\assets\EasyEject.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EasyEjectUiTests)' == 'true'">
    <DefineConstants>$(DefineConstants);UI_TESTS</DefineConstants>
    <StartupObject>EasyEject.Modern.UiTestHost</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="..\EasyEject.Runtime.csproj" />
    <Content Include="..\..\assets\EasyEject.png" Link="Assets\EasyEject.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(EasyEjectUiTests)' == 'true'">
    <!-- App-scoped rendering probes are engineering-only; production follows Windows. -->
    <Compile Include="..\tests\UiThemeInspection.cs" />
  </ItemGroup>
  <!-- WinUI generates this PRI in the build output, but the SDK's publish
       list does not include it. Without it, unpackaged XAML startup fails. -->
  <Target Name="PublishEasyEjectXamlResources" AfterTargets="ComputeResolvedFilesToPublishList">
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="The compiled Easy Eject XAML resource index is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>$(TargetName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
