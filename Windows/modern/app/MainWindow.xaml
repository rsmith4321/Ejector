<Window x:Class="EasyEject.Modern.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:EasyEject.Modern" Title="Easy Eject">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView x:Name="Navigation" ItemInvoked="Navigation_ItemInvoked" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="218" AlwaysShowHeader="False">
   <NavigationView.PaneHeader><StackPanel Margin="20,24,0,24" Spacing="6"><TextBlock Text="Easy Eject" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Storage, safely handled" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.MenuItems><NavigationViewItem x:Name="StorageNavigation" Content="Connected storage" Tag="storage" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F1;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="ProfilesNavigation" Content="Saved profiles" Tag="profiles"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="DefaultsNavigation" Content="Import defaults" Tag="defaults"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
   <NavigationView.PaneFooter><StackPanel Margin="20,12,16,24" Spacing="8"><TextBlock Text="Interface preview" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Verified imports, exact saved history and manual sharing copies. Full port acceptance is still in progress." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneFooter>
   <Grid>
   <Grid x:Name="StorageView" Padding="36,28,36,24" RowSpacing="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="8"><TextBlock Text="Connected storage" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="Summary" Text="Checking your connected drives…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <Button x:Name="Refresh" Grid.Column="1" VerticalAlignment="Center" Click="Refresh_Click" AutomationProperties.Name="Refresh connected storage"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh"/><TextBlock Text="Refresh"/></StackPanel></Button>
    </Grid>
    <ListView Grid.Row="1" x:Name="StorageCards" SelectionMode="Single" SelectionChanged="Storage_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="local:StorageCard">
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
      <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <FontIcon Glyph="&#xE7F1;" FontSize="28" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
       <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6" Padding="10,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="{x:Bind State}" FontSize="12"/></Border>
      </Grid>
     </Border>
    </DataTemplate></ListView.ItemTemplate></ListView>
    <StackPanel Grid.Row="2" Spacing="12"><TextBlock x:Name="SelectionStatus" Text="Select a device to review safe removal." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ScrollViewer MaxHeight="96" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ImportStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></ScrollViewer><ProgressBar x:Name="ImportProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="Eject" Content="Safe eject…" IsEnabled="False" Click="Eject_Click"/><Button x:Name="CleanEject" Content="Clean &amp; eject…" IsEnabled="False" Click="CleanEject_Click"/><Button x:Name="CancelOperation" Content="Stop cleanup" Visibility="Collapsed" Click="CancelOperation_Click"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="Import" Content="Verified import…" IsEnabled="False" Click="Import_Click"/><Button x:Name="Resume" Content="Resume interrupted import…" IsEnabled="False" Click="Resume_Click"/><Button x:Name="EditProfile" Content="Import profile…" IsEnabled="False" Click="Profile_Click"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Import history…" Click="History_Click"/><Button Content="Quick Share tools…" Click="QuickShareTools_Click"/></StackPanel><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE946;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Close this window to keep Easy Eject in the tray beside the clock." TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border></StackPanel>
   </Grid>
   <local:ImportDefaultsView x:Name="DefaultsPanel" Visibility="Collapsed"/>
   <local:ProfilesView x:Name="ProfilesPanel" Visibility="Collapsed"/>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
