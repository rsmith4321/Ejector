<Window x:Class="EasyEject.Modern.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:EasyEject.Modern" Title="Easy Eject">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <NavigationView IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="218" AlwaysShowHeader="False">
   <NavigationView.PaneHeader><StackPanel Margin="20,24,0,24" Spacing="6"><TextBlock Text="Easy Eject" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Storage, safely handled" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.MenuItems><NavigationViewItem Content="Connected storage" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F1;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
   <NavigationView.PaneFooter><StackPanel Margin="20,12,16,24" Spacing="8"><TextBlock Text="Interface preview" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="No imports or device changes" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneFooter>
   <Grid Padding="36,28,36,24" RowSpacing="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="8"><TextBlock Text="Connected storage" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="Summary" Text="Checking your connected drives…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <Button x:Name="Refresh" Grid.Column="1" VerticalAlignment="Center" Click="Refresh_Click" AutomationProperties.Name="Refresh connected storage"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh"/><TextBlock Text="Refresh"/></StackPanel></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="StorageCards"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:StorageCard">
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
      <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <FontIcon Glyph="&#xE7F1;" FontSize="28" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
       <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
       <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6" Padding="10,6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="{x:Bind State}" FontSize="12"/></Border>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE946;" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Close this window to keep Easy Eject in the tray beside the clock." TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
